{
  "name": "portfolio-webpage",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "lint": "eslint \"{src,cypress}/**/*.{ts,html,js}\"",
    "e2e": "cypress run",
    "format": "prettier --write .",
    "check": "npm run lint && npm run test && npm run build",
    "dev:ssr": "ng run portfolio-webpage:serve-ssr",
    "build:ssr": "ng run portfolio-webpage:build-ssr",
    "prerender": "ng run portfolio-webpage:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/cdk": "^19.2.8",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-server": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/ssr": "^19.2.0",
    "express": "^4.19.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.0",
    "@cypress/webpack-dev-server": "^5.1.3",
    "@testing-library/angular": "^14.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "cypress": "^15.0.0",
    "eslint": "^9.15.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^2.14.0",
    "husky": "^9.1.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2"
  }
}
